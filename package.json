{
  "name": "x402-metered-agent-demo",
  "version": "0.1.0",
  "description": "Metered agent paying a real x402 endpoint per call from a Catena account, with a configured spend cap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catena-oss/x402-metered-agent-demo.git"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "demo": "tsx scripts/run.ts",
    "run:metered": "tsx scripts/run.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.30.0",
    "prettier": "^3.9.5",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
